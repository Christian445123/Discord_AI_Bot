# ============================================================
#  Discord KI-Bot - Konfiguration
#  Diese Datei als ".env" kopieren und ausfuellen.
#  Die ".env" ist die LIVE-Datei und wird NICHT auf GitHub geladen.
# ============================================================

# --- Discord ---
DISCORD_TOKEN=
GUILD_ID=

# --- Datenbank (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- Web-Panel ---
PANEL_USER=admin
# Wird von install.php erzeugt (password_hash) - nicht von Hand ausfuellen
PANEL_PASSWORD_HASH=
PANEL_PORT=8080

# --- Server / Tonfall ---
SERVER_NAME=ViennaStateRP
# du oder sie
ADDRESS_FORM=du

# --- Team ---
# Rollen-IDs des Teams, kommagetrennt (Nachrichten dieser Rollen werden als "Teamler-Antwort" gelernt)
TEAM_ROLE_IDS=
# Optional: Rolle, die bei Eskalationen markiert wird
MOD_ROLE_ID=
# Optional: Channel, in dem der Bot Eskalationen meldet
LOG_CHANNEL_ID=

# --- Support / Fragen ---
# Channel-IDs, in denen der Bot Fragen beantwortet (leer = alle Channels)
QUESTION_CHANNEL_IDS=
# Sekunden, die der Bot wartet, ob ein Teamler zuerst antwortet
ANSWER_DELAY_SECONDS=90
# Mindest-Aehnlichkeit (0.0 - 1.0), ab der der Bot eine gelernte Antwort gibt
MIN_CONFIDENCE=0.55
# Zeitfenster (Sekunden), in dem eine Teamler-Nachricht einer offenen Frage zugeordnet wird
LEARN_WINDOW_SECONDS=900
# Wenn keine passende Antwort bekannt ist: freundlichen Hinweis ausgeben (true/false)
FALLBACK_ENABLED=true

# --- Channel-Ueberwachung ---
MODERATION_ENABLED=true
# Channel-IDs, die NICHT ueberwacht werden, kommagetrennt
MODERATION_IGNORE_CHANNEL_IDS=
# Ab diesem "Hitze"-Wert greift der Bot ein
HEAT_THRESHOLD=6
# Sekunden Pause zwischen zwei Eingriffen im selben Channel
INTERVENTION_COOLDOWN_SECONDS=120
# Zusaetzliche Reizwoerter, kommagetrennt (werden zu den Standardwoertern addiert)
EXTRA_BAD_WORDS=
